# ===== 数据库（本地 PostgreSQL 16，直接连接，无需 Docker）=====
DATABASE_URL=postgres://crm:crm_dev_password@localhost:5432/litecrm

# ===== 生产环境首次初始化（只在空业务库首次部署时使用）=====
# 密码必须通过部署平台 Secret 注入；这里故意不提供可直接使用的真实值。
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_STAFF_PASSWORD_SUFFIX=

# ===== JWT =====
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=14d

# ===== 服务端口 =====
PORT=3001

# ===== 生产环境 HTTP 边界 =====
# 同源 Nginx 反代无需 CORS；只有确有跨域调用时才填写逗号分隔的完整 origin。
CORS_ORIGINS=
# 生产默认不暴露 Swagger；临时排障开启后应及时关闭。
ENABLE_SWAGGER=false
