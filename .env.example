# ===== 数据库（本地 docker compose 起 PG16）=====
DATABASE_URL=postgres://crm:crm_dev_password@localhost:5433/litecrm

# ===== 生产环境首次初始化（只在空业务库首次部署时使用）=====
# 密码必须通过部署平台 Secret 注入；这里故意不提供可直接使用的真实值。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
BOOTSTRAP_ADMIN_JOB_TITLE=系统管理员

# ===== JWT =====
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=14d

# ===== 服务端口 =====
PORT=3001
