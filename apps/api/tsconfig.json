{
  "extends": "../../packages/tsconfig/node.json",
  "compilerOptions": {
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "incremental": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "scripts/**/*.ts"],
  "ts-node": {
    "files": true
  }
}
