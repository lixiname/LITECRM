{
  "name": "@crm/contracts",
  "version": "1.0.0",
  "description": "前后端契约：openapi-typescript 生成物（类型唯一来源）+ 少量补充类型",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/generated/api.ts",
    "check": "openapi-typescript openapi.json -o src/generated/api.ts --verify"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
