    "/customers": {
      "post": {
        "operationId": "CustomersController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCustomerDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "建档成功"
          }
        },
        "tags": ["customers"]
      },
      "get": {
        "operationId": "CustomersController_findAll",
        "parameters": [
          {
            "name": "keyword",
            "required": false,
            "in": "query",
            "description": "检索词（完全>前缀>包含>城市/别名兜底）",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "required": false,
            "in": "query",
            "description": "城市筛选",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "industry",
            "required": false,
            "in": "query",
            "description": "产业筛选",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "customerType",
            "required": false,
            "in": "query",
            "description": "客户类型筛选",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "level",
            "required": false,
            "in": "query",
            "description": "分级筛选",
            "schema": {
              "type": "string",
              "enum": ["S", "A", "B", "C"]
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "状态筛选",
            "schema": {
              "type": "string",
              "enum": ["active", "invalid", "public"]
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "页码（从 1 开始）",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "description": "每页条数（默认 20，最大 50）",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "客户列表（数据范围过滤 + 五级检索 + 分页）"
          }
        },
        "tags": ["customers"]
      }
    },
    "/customers/{id}": {
      "get": {
        "operationId": "CustomersController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "客户详情（含联系人）"
          }
        },
        "tags": ["customers"]
      },
      "patch": {
        "operationId": "CustomersController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCustomerDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新客户（owner/管理链/admin）"
          }
        },
        "tags": ["customers"]
      }
    },
    "/customers/{id}/contacts": {
      "post": {
        "operationId": "CustomersController_addContact",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateContactDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "新增联系人"
          }
        },
        "tags": ["customers"]
      }
    },
    "/customers/contacts/{contactId}": {
      "patch": {
        "operationId": "CustomersController_updateContact",
        "parameters": [
          {
            "name": "contactId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateContactDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新联系人"
          }
        },
        "tags": ["customers"]
      },
      "delete": {
        "operationId": "CustomersController_removeContact",
        "parameters": [
          {
            "name": "contactId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "删除联系人"
          }
        },
        "tags": ["customers"]
      }
    }
  },
  "info": {
    "title": "Lite CRM API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "登录用户名"
          },
          "password": {
            "type": "string",
            "description": "密码"
          }
        },
        "required": ["username", "password"]
      },
      "Role": {
        "type": "string",
        "enum": ["sales", "executive", "assistant", "admin"],
        "description": "角色"
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "用户 ID"
          },
          "username": {
            "type": "string",
            "description": "登录用户名"
          },
          "displayName": {
            "type": "string",
            "description": "显示名"
          },
          "role": {
            "description": "角色",
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          }
        },
        "required": ["id", "username", "displayName", "role"]
      },
      "Ability": {
        "type": "string",
        "enum": [
          "customer.write",
          "customer.transfer",
          "approve.claim",
          "dashboard.view",
          "stats.view",
          "export",
          "user.manage"
        ],
        "description": "能力点快照"
      },
      "DataScope": {
        "type": "string",
        "enum": ["self", "team", "full"],
        "description": "数据范围快照"
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "description": "当前用户",
            "allOf": [
              {
                "$ref": "#/components/schemas/AuthUserDto"
              }
            ]
          },
          "accessToken": {
            "type": "string",
            "description": "访问令牌（2h）"
          },
          "refreshToken": {
            "type": "string",
            "description": "刷新令牌（14d，滑动续期）"
          },
          "capabilities": {
            "type": "array",
            "description": "能力点快照",
            "items": {
              "$ref": "#/components/schemas/Ability"
            }
          },
          "dataScope": {
            "description": "数据范围快照",
            "allOf": [
              {
                "$ref": "#/components/schemas/DataScope"
              }
            ]
          }
        },
        "required": ["user", "accessToken", "refreshToken", "capabilities", "dataScope"]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "刷新令牌"
          }
        },
        "required": ["refreshToken"]
      },
      "TokenPairDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "新的访问令牌（2h）"
          },
          "refreshToken": {
            "type": "string",
            "description": "新的刷新令牌（14d，滑动续期）"
          }
        },
        "required": ["accessToken", "refreshToken"]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "oldPassword": {
            "type": "string",
            "description": "旧密码"
          },
          "newPassword": {
            "type": "string",
            "description": "新密码（至少 8 位）"
          }
        },
        "required": ["oldPassword", "newPassword"]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "用户 ID"
          },
          "username": {
            "type": "string",
            "description": "登录用户名"
          },
          "displayName": {
            "type": "string",
            "description": "显示名"
          },
          "role": {
            "description": "角色",
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "description": "手机号（钉钉绑定预留）"
          },
          "reportsToId": {
            "type": "string",
            "nullable": true,
            "description": "直属上级 ID（组织树）"
          },
          "region": {
            "type": "string",
            "nullable": true,
            "description": "区域"
          },
          "isActive": {
            "type": "boolean",
            "description": "是否启用"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "创建时间"
          }
        },
        "required": ["id", "username", "displayName", "role", "isActive", "createdAt"]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "登录用户名"
          },
          "password": {
            "type": "string",
            "description": "初始密码（至少 8 位）"
          },
          "displayName": {
            "type": "string",
            "description": "显示名"
          },
          "role": {
            "description": "角色",
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          },
          "reportsToId": {
            "type": "string",
            "description": "直属上级 ID（组织树）"
          },
          "phone": {
            "type": "string",
            "description": "手机号（钉钉绑定预留）"
          },
          "region": {
            "type": "string",
            "description": "区域"
          }
        },
        "required": ["username", "password", "displayName", "role"]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "description": "显示名"
          },
          "role": {
            "description": "角色",
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          },
          "reportsToId": {
            "type": "string",
            "nullable": true,
            "description": "直属上级 ID（组织树，null=顶层）"
          },
          "phone": {
            "type": "string",
            "description": "手机号（钉钉绑定预留）"
          },
          "region": {
            "type": "string",
            "description": "区域"
          },
          "isActive": {
            "type": "boolean",
            "description": "是否启用"
          }
        }
      },
      "CustomerDimension": {
        "type": "string",
        "enum": ["industry", "sub_industry", "customer_type", "product_line", "source"],
        "description": "维度"
      },
      "CreateDimensionOptionDto": {
        "type": "object",
        "properties": {
          "dimension": {
            "description": "维度",
            "allOf": [
              {
                "$ref": "#/components/schemas/CustomerDimension"
              }
            ]
          },
          "name": {
            "type": "string",
            "description": "选项名称（维度内唯一）"
          },
          "sortOrder": {
            "type": "number",
            "description": "排序权重"
          }
        },
        "required": ["dimension", "name"]
      },
      "UpdateDimensionOptionDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "选项名称（维度内唯一）"
          },
          "sortOrder": {
            "type": "number",
            "description": "排序权重"
          },
          "isActive": {
            "type": "boolean",
            "description": "是否启用"
          }
        }
      },
      "CustomerLevel": {
        "type": "string",
        "enum": ["S", "A", "B", "C"],
        "description": "分级容量 S/A/B/C"
      },
      "CreateContactDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "姓名（可空=裸电话）"
          },
          "title": {
            "type": "string",
            "description": "职位"
          },
          "phone": {
            "type": "string",
            "description": "电话（每个客户至少一个联系人含电话）"
          },
          "isKeyContact": {
            "type": "boolean",
            "description": "是否首要联系人（每客户至多一个）"
          }
        }
      },
      "CreateCustomerDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "客户名称（可地址式）"
          },
          "aliasNames": {
            "description": "别名/简称",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "customerCode": {
            "type": "string",
            "description": "客户编码（ERP，权威硬查重键）"
          },
          "unifiedSocialCreditCode": {
            "type": "string",
            "description": "统一社会信用代码（权威硬查重键）"
          },
          "industry": {
            "type": "string",
            "description": "产业（字典快照）"
          },
          "subIndustry": {
            "type": "string",
            "description": "二级行业（字典快照）"
          },
          "customerType": {
            "type": "string",
            "description": "客户类型（字典快照）"
          },
          "productLines": {
            "description": "产品线（字典快照）",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "city": {
            "type": "string",
            "description": "城市"
          },
          "province": {
            "type": "string",
            "description": "省份"
          },
          "address": {
            "type": "string",
            "description": "地址"
          },
          "website": {
            "type": "string",
            "description": "网址"
          },
          "source": {
            "type": "string",
